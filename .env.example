# Copy the values you need into Vercel Project Settings -> Environment Variables.
# This file is never read by the app itself and holds no real secrets.

# --- Anthropic (server-side only, never exposed to the browser) ---
ANTHROPIC_API_KEY=
# Exact model id, see docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional. Max chat messages a single user can send per day. Defaults to 50.
DAILY_MESSAGE_LIMIT=50

# --- Supabase ---
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
# The "anon" / "public" key. Safe to expose to the browser (Row Level
# Security is what actually protects the data, not secrecy of this key).
SUPABASE_ANON_KEY=
# The "service_role" key. NEVER expose this to the browser. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Used only by scripts/import-claude-export.mjs, run locally ---
# (reuses SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above)
